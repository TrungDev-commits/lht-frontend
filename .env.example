# URL gốc của backend Express (Render). Ví dụ: https://lht-backend.onrender.com
# Để trống thì API gọi tương đối (chỉ dùng khi dev có proxy vite).
# Build production thiếu biến này sẽ tự fallback về https://lht-backend.onrender.com.
VITE_API_BASE_URL=

# Bí mật bảo vệ /api/pipeline/run — phải trùng với PIPELINE_SECRET của backend.
# Frontend gửi trong body { secret }, nên bắt buộc đặt khi backend có khóa.
VITE_PIPELINE_SECRET=
